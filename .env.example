# Monitor Enable/Disable Flags
# Set to 'true' or 'false' to enable/disable specific monitors
ENABLE_ETHEREUM_MONITOR=true    # Default: true (for backward compatibility)
ENABLE_REDIS_MONITOR=false       # Default: false
ENABLE_DISK_MONITOR=false        # Default: false
ENABLE_PM2_MONITOR=false         # Default: false

# Ethereum Configuration
ETHEREUM_WS_URL=ws://localhost:8545

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                 # Optional: Leave empty if no password
REDIS_DB=0                      # Optional: Database number (default: 0)

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Ethereum Monitoring Settings (optional)
BLOCK_TIMEOUT_SECONDS=60        # Seconds to wait before considering node unhealthy

# Redis Monitoring Settings (optional)
REDIS_HEALTH_CHECK_INTERVAL_MS=30000    # How often to check Redis health (default: 30 seconds)
REDIS_TIMEOUT_MS=5000                    # Timeout for Redis operations (default: 5 seconds)
REDIS_MEMORY_ALERT_THRESHOLD_MB=1000    # Optional: Alert when memory usage exceeds this value

# Disk Monitoring Settings
DISK_PATH=/                      # Path to monitor (default: /)
DISK_THRESHOLD_PERCENT=80        # Alert when disk usage exceeds this percentage (default: 80)

# PM2 Monitoring Settings
PM2_CHECK_INTERVAL_MS=30000      # How often to check PM2 processes (default: 30 seconds)

# Common Monitoring Settings (optional)
MAX_RECONNECT_ATTEMPTS=3        # Max attempts to reconnect before alerting
RECONNECT_DELAY_MS=5000         # Delay between reconnection attempts

# Redis-specific reconnection settings (optional, falls back to common settings if not specified)
REDIS_MAX_RECONNECT_ATTEMPTS=   # Leave empty to use MAX_RECONNECT_ATTEMPTS
REDIS_RECONNECT_DELAY_MS=        # Leave empty to use RECONNECT_DELAY_MS